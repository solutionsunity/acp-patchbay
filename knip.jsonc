{
  // Unused code the compiler can't see: an export nothing imports, a file
  // nothing reaches, a dependency the manifest names but nothing uses — or
  // one the code uses that the manifest doesn't name. Run by the gate.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // the webview bundles esbuild.mjs builds — knip reads the other entry
    // points out of esbuild.mjs itself, which it finds from the scripts
    "src/webview/*/index.tsx",
    // the suites and what they run
    "test/**/*.test.ts",
    "test/fake-agent/main.ts",
    // a drive run by hand (npx tsx), against a real agent
    "test/support/e2e-repair-drive.ts",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "test/**/*.ts", "scripts/**/*.mjs"],
  // shadcn components are source copies: each keeps its whole API, used or not
  "ignore": ["src/webview/components/ui/**"],
  // a type a module's own signatures use is part of its surface
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignoreDependencies": [
    // copied into out/ by esbuild.mjs, by path
    "@vscode/codicons",
    // imported from CSS (theme.css)
    "tailwindcss",
    // ambient types for the webviews
    "@types/vscode-webview",
    // loaded by the vscode-test runner
    "@vscode/test-electron"
  ]
}
