{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "out-test",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node", "mocha", "vscode"]
  },
  "include": ["test/vscode", "src/types"]
}
