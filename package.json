{
  "name": "acp-patchbay",
  "displayName": "ACP Patchbay",
  "description": "Any ACP agent. Every integration it can accept. Shown exactly as it is.",
  "version": "0.82.5",
  "publisher": "SolutionsUnity",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/solutionsunity/acp-patchbay.git"
  },
  "bugs": {
    "url": "https://github.com/solutionsunity/acp-patchbay/issues"
  },
  "homepage": "https://solutionsunity.com/products/vscode-acp-patchbay",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "acp",
    "agent",
    "mcp",
    "agent-client-protocol",
    "ai"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "colors": [
      {
        "id": "acpPatchbay.brand",
        "description": "Patchbay identity accent (suctl blue) — chips, accents, focus cues; never a status verdict",
        "defaults": {
          "dark": "#5b9bd5",
          "light": "#2e6da4",
          "highContrast": "#5b9bd5",
          "highContrastLight": "#2e6da4"
        }
      },
      {
        "id": "acpPatchbay.ok",
        "description": "Healthy / confirmed / used — running dots, used capability cells, fully-brokered fidelity",
        "defaults": {
          "dark": "#4ec9a0",
          "light": "#177245",
          "highContrast": "#4ec9a0",
          "highContrastLight": "#177245"
        }
      },
      {
        "id": "acpPatchbay.warn",
        "description": "Attention — suspect capability cells, update badges, plug-in confirmations",
        "defaults": {
          "dark": "#e5a830",
          "light": "#8a5d00",
          "highContrast": "#e5a830",
          "highContrastLight": "#8a5d00"
        }
      },
      {
        "id": "acpPatchbay.err",
        "description": "Error / danger — crashed agents, acts-outside fidelity",
        "defaults": {
          "dark": "#e06c75",
          "light": "#b3444f",
          "highContrast": "#e06c75",
          "highContrastLight": "#b3444f"
        }
      },
      {
        "id": "acpPatchbay.consumed",
        "description": "Metrics / throughput — usage gauge, key-mechanism chips",
        "defaults": {
          "dark": "#56b6c2",
          "light": "#0f6674",
          "highContrast": "#56b6c2",
          "highContrastLight": "#0f6674"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acp-patchbay",
          "title": "Patchbay",
          "icon": "media/patchbay.svg"
        }
      ]
    },
    "views": {
      "acp-patchbay": [
        {
          "id": "acpPatchbay.agentView",
          "name": "Agent View",
          "type": "webview",
          "icon": "media/patchbay.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "acpPatchbay.openSettings",
        "title": "Open Settings",
        "category": "Patchbay",
        "icon": "$(gear)"
      },
      {
        "command": "acpPatchbay.newSession",
        "title": "New Session",
        "category": "Patchbay"
      },
      {
        "command": "acpPatchbay.switchSession",
        "title": "Switch Session",
        "category": "Patchbay"
      },
      {
        "command": "acpPatchbay.connectAgent",
        "title": "Connect Agent",
        "category": "Patchbay"
      },
      {
        "command": "acpPatchbay.addSelectionToContext",
        "title": "Add Selection to Patchbay Context",
        "category": "Patchbay"
      },
      {
        "command": "acpPatchbay.wireLog",
        "title": "Wire Log — Toggle / Extend",
        "category": "Patchbay"
      },
      {
        "command": "acpPatchbay.detachAgentView",
        "title": "Open Agent View in New Window",
        "category": "Patchbay",
        "icon": "$(multiple-windows)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "acpPatchbay.addSelectionToContext",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste"
        }
      ],
      "commandPalette": [
        {
          "command": "acpPatchbay.detachAgentView",
          "when": "acpPatchbay.detachEnabled"
        }
      ],
      "view/title": [
        {
          "command": "acpPatchbay.openSettings",
          "when": "view == acpPatchbay.agentView",
          "group": "navigation"
        },
        {
          "command": "acpPatchbay.detachAgentView",
          "when": "view == acpPatchbay.agentView && acpPatchbay.detachEnabled",
          "group": "navigation"
        }
      ]
    }
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:vscode": "npm run build && node scripts/build-fake-agent.mjs && tsc -p tsconfig.test.json",
    "test:vscode": "vscode-test",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package",
    "ui:shots": "node scripts/ui-gate/shots.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@lexical/react": "^0.46.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.96.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitest/eslint-plugin": "^1.6.21",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "katex": "^0.17.0",
    "lexical": "^0.46.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  }
}
