      "url": "https://api.githubcopilot.com/mcp/",
      "docsUrl": "https://github.com/github/github-mcp-server",
      "note": "GitHub's official remote MCP server. Uses a Personal Access Token — its OAuth is not open to third-party clients (no dynamic client registration).",
      "auth": {
        "header": {
          "hint": "Personal Access Token from github.com/settings/tokens (repo + read:org for full tool coverage)",
          "keyUrl": "https://github.com/settings/tokens"
