          "ghcr.io/github/github-mcp-server"
        ],
        "envKeys": [
          "GITHUB_PERSONAL_ACCESS_TOKEN"
        ],
        "note": "official github-mcp-server via Docker; a native binary also exists — see Docs"
      }
    },
